# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=https://nikomilbg.com

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=NIKOMIL

# Google Search Console verifikacija (content vrednost iz "HTML tag" metode)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Kontakt forma (Mailjet) ──────────────────
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SITE_MAIL_SENDER=noreply@primer.com
SITE_MAIL_SENDER_NAME=NIKOMIL sajt
SITE_MAIL_RECEIVER=nikomilbg@gmail.com
